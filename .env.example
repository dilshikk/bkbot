# Скопируйте в .env и заполните своими значениями
BOT_TOKEN=123456789:AAExampleToken
DATABASE_URL=postgresql+asyncpg://bot:password@localhost:5432/bkbot
REDIS_URL=redis://localhost:6379/0
ADMIN_IDS=[111111111,222222222]
GROUP_ID=0
MODERATION_ENABLED=false

# Уведомлять админов о каждом новом пользователе
NOTIFY_NEW_USERS=false

# Удалять системные сообщения в группах, где бот — администратор
CLEAN_SERVICE_MESSAGES=true

# Команды /app и /link в группах
GROUP_COMMANDS_ENABLED=true
# Разрешённые группы, например [-1001234567890]. Пусто — все группы
GROUP_COMMANDS_CHAT_IDS=[]
# Секунд между одинаковыми командами в одном чате (0 — без ограничения)
GROUP_COMMANDS_COOLDOWN=30
# Через сколько секунд удалять ответ бота (0 — не удалять по таймеру)
GROUP_LINK_REPLY_TTL=120
GROUP_APP_REPLY_TTL=300

# Антиспам: не больше THROTTLE_RATE сообщений за THROTTLE_PERIOD секунд
THROTTLE_RATE=3
THROTTLE_PERIOD=2
THROTTLE_BAN_COUNT=20
THROTTLE_BAN_TTL=300

# Прокси для проверки зеркал из нужной страны (необязательно)
HEALTHCHECK_PROXY=
# Считать ответ 403 рабочим (Cloudflare). Выключите, если блокировка отвечает 403
HEALTHCHECK_OK_403=true
# Все активные зеркала упали — включить следующее рабочее по приоритету
AUTO_SWITCH_ON_DOWN=true
