# Скопируйте в .env и заполните своими значениями
BOT_TOKEN=123456789:AAExampleToken
DATABASE_URL=postgresql+asyncpg://bot:password@localhost:5432/bkbot
REDIS_URL=redis://localhost:6379/0
ADMIN_IDS=[111111111,222222222]
GROUP_ID=0
MODERATION_ENABLED=false

# Уведомлять админов о каждом новом пользователе
NOTIFY_NEW_USERS=false

# Удалять системные сообщения в группах, где бот — администратор
CLEAN_SERVICE_MESSAGES=true

# Антиспам: не больше THROTTLE_RATE сообщений за THROTTLE_PERIOD секунд
THROTTLE_RATE=3
THROTTLE_PERIOD=2
THROTTLE_BAN_COUNT=20
THROTTLE_BAN_TTL=300

# Прокси для проверки зеркал из нужной страны (необязательно)
HEALTHCHECK_PROXY=
